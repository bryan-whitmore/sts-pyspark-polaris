# Secrets for the Polaris server + bootstrap/setup sidecars.
# Gitignored: do not commit this file.

# Must match ../postgres/.env.secrets
POSTGRES_DB=polaris
POSTGRES_USER=polaris
POSTGRES_PASSWORD=CHANGE_ME

# Polaris realm root/admin principal, created by the bootstrap step.
ROOT_CLIENT_ID=root
ROOT_CLIENT_SECRET=CHANGE_ME

# Both key pairs below are written here by vms/provision.py; nothing needs to
# be filled in by hand.

# The polaris-sts user's permanent key, which signs the sts:AssumeRole call
# Polaris makes against the VAST STS endpoint. That user holds no identity
# policy at all, so this key can do nothing but assume the role named by
# VAST_ROLE_ARN -- whose Trust Policy in turn names only this user.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# The polaris-db-admin user's key, used only by the one-shot vastdb-setup
# sidecar to create the VASTDB schema and its tables. Scoped to tabular DDL
# on that one schema; deliberately not the signer above, and deliberately
# not an identity any notebook ever uses.
VASTDB_ADMIN_ACCESS_KEY_ID=CHANGE_ME
VASTDB_ADMIN_SECRET_ACCESS_KEY=CHANGE_ME
