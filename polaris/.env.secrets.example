# Secrets for the Polaris server + bootstrap/setup sidecars.
# Gitignored: do not commit this file.

# Must match ../postgres/.env.secrets
POSTGRES_DB=polaris
POSTGRES_USER=polaris
POSTGRES_PASSWORD=CHANGE_ME

# Polaris realm root/admin principal, created by the bootstrap step.
ROOT_CLIENT_ID=root
ROOT_CLIENT_SECRET=CHANGE_ME

# Permanent VAST access key that signs the sts:AssumeRole call Polaris makes
# against the VAST STS endpoint. This is the [var203] key pair already used
# by the Trino "vast" connector (see ~/vast-docker-compose-examples/trino/generated/vast203.properties).
# The VMS username that owns this key pair is whatever the runbook's [VMS]
# Trust Policy step lists under Principal.User - confirm it in VMS
# (User Management > Users) before creating the AIM role.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
