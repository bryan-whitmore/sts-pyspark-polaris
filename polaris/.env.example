# Non-secret Polaris demo settings.

POLARIS_REALM=polaris_demo
CATALOG_NAME=sts_demo
POLARIS_VERSION=1.7.0

# S3 data-plane endpoint (GetObject/PutObject/etc) — plain HTTP:80 works
# fine here, same as the rest of this project's VAST S3 usage.
VAST_S3_ENDPOINT=http://CHANGE_ME

# STS specifically requires HTTPS:443 on this cluster (confirmed via
# runbook.md step 3 — plain HTTP:80 gets AccessDenied on AssumeRole even
# with correct policies). Self-signed cert, and the cert's SAN doesn't
# cover the raw VIP — hostname "sts.vastdata.com" is a docker-compose
# extra_hosts entry (see polaris/docker-compose.yml) mapping to the same
# VIP, chosen to match the cert's *.vastdata.com wildcard SAN so Polaris's
# Java HTTP client's hostname check passes. Not a real DNS name.
VAST_STS_ENDPOINT=https://sts.vastdata.com:443

# Real VIP behind the sts.vastdata.com extra_hosts entry above (see
# polaris/docker-compose.yml) — kept as its own var so compose can
# interpolate it into extra_hosts without hardcoding the IP in a
# git-tracked file.
VAST_STS_IP=CHANGE_ME

VAST_S3_REGION=us-east-1

# Where in the whitmore bucket this demo's tables live.
VAST_BUCKET=CHANGE_ME
VAST_BUCKET_PREFIX=polaris_demo

# whitmore is also a VAST Database — this schema holds the additional
# tables read/written via the VAST DB Spark connector (registered in
# Polaris as Generic Tables — metadata only, NOT STS-vended; see
# runbook.md's VASTDB extension section for why).
VASTDB_SCHEMA=polaris_demo_db

# All CNode VIPs, comma-separated. setup.sh copies this into each Generic
# Table's vastdb.data_endpoints property, which the notebooks read back
# into spark.ndb.data_endpoints so the connector spreads reads across
# CNodes. Unlike Polaris's own single-endpoint STS/S3 config, the VAST
# connector does take a list. Must be filled in even though it duplicates
# jupyter/creds/vastdb_endpoint.env — the jupyter compose stack doesn't
# share this file.
VASTDB_DATA_ENDPOINTS=http://CHANGE_ME,http://CHANGE_ME

# Existing AIM Role "test" on the default tenant (reused — new role
# creation is blocked on this tenant by its replication config; see
# runbook.md step 2).
#
# Uses VAST's older 6-field ARN format (arn:vast:iam::<tenant>:role/<name>),
# NOT the 5-field form (arn:vast::<tenant>:role/<name>) that step 3's raw
# CLI check used successfully. Apache Polaris 1.7.0 hardcodes a 6-field ARN
# regex and rejects the 5-field VAST form with "Invalid role ARN format"
# (apache/polaris#5099, unresolved upstream) — so Polaris specifically needs
# this legacy shape even though the CLI test above used the newer one.
VAST_ROLE_ARN=arn:vast:iam::CHANGE_ME:role/CHANGE_ME
