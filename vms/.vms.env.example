# VMS admin credentials for vms/provision.py. Copy to vms/.vms.env
# (chmod 600; gitignored) and fill in.
#
# Needs VMS_ADDRESS plus either VMS_TOKEN, or VMS_USER + VMS_PASSWORD.
# Mint a 52-week token with:
#   POST /api/apitokens/  {"name": "...", "expiry_date": "52w"}
# That endpoint rejects ISO dates; expiry_date must be relative.

VMS_ADDRESS=CHANGE_ME
VMS_TOKEN=CHANGE_ME
