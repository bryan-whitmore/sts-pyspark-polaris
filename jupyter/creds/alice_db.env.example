# Template for alice_db.env (gitignored). The alice-db user's table-scoped VAST
# access key, written here by vms/provision.py — see runbook.md step 2.
# Written 0640 group "users", not 0600: the Jupyter container reads it as
# jovyan (uid 1000, gid 100), which does not match the host account's uid.
VASTDB_ACCESS_KEY_ID=CHANGE_ME
VASTDB_SECRET_ACCESS_KEY=CHANGE_ME
